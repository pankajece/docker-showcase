# stage 1 build the React App 
FROM node:16.17-alpine as build

#set the working directory 
WORKDIR /app

# Copy dependency files first (better caching)
COPY package*.json ./

# Install dependencies securely (no cache, audit)
RUN npm ci --only=production --ignore-scripts

#Copy the all applicatin code to container 
COPY . .

#Build the applicaton 
RUN npm run build 

# artficat iscreated now in app folder 

#Create the minimla production ready image light weigh 
FROM nginx:alpine

#set the non-root user for security 
RUN addgroup -g 1001 -S appgroup && \
 adduser -S appuser -u 1001 -G appgroup

 # Remove default nginx config and replace with custom
RUN rm /etc/nginx/conf.d/default.conf
COPY nginx.conf /etc/nginx/conf.d

#COPY artifcat form teh build stage to new ngixn cntainer 
COPY --from=build /app/build /usr/share/nginx/html 

# Fix permissions for Nginx cache, run, and log dirs
RUN mkdir -p /var/cache/nginx /var/run /run /var/log/nginx && \
    chown -R appuser:appgroup /var/cache/nginx /var/run /run /var/log/nginx

    

# Switch to non-root user
USER appuser

#Expose the port at 80 
EXPOSE 80

# Run nginx in foreground
CMD ["nginx", "-g", "daemon off;"]



